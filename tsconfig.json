{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["nativewind/types", "jest"]
  },
  "include": ["app", "src", "tests", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
