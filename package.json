{
  "name": "uwaci-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app src tests scripts eslint.config.mjs babel.config.js metro.config.js tailwind.config.js jest.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "validate:branch": "node scripts/git/validate-branch.mjs",
    "validate:branch:test": "node --test scripts/git/validate-branch.test.mjs",
    "validate:expo": "expo config --type public",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run validate:branch:test && npm run validate:expo",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
